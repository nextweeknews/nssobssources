+  assert.equal(data.matches[1].results[0].tied,false);
+  assert.equal(data.matches[0].results[0].players.length,1);
+  assert.equal(worker.calls.length,1);
+  await worker.request();
+  assert.equal(worker.calls.length,1);
+});
